{number:"02",title:"Nacionalidad española",text:"Te orientamos sobre nacionalidad por residencia, opción y otros supuestos.",href:"/nacionalidad/"},
{number:"03",title:"Residencia y trabajo",text:"Residencia por cuenta ajena o propia, renovaciones y modificaciones.",href:"/residencia-trabajo/"},
{number:"04",title:"Familia y reagrupación",text:"Reagrupación y residencia de familiares de españoles o comunitarios.",href:"/familia/"},
{number:"05",title:"Asilo y protección internacional",text:"Solicitud, documentación, recursos y alternativas tras una denegación.",href:"/asilo/"},
